[3.0532, "o", "\u001b[K\u001b[1A\u001b[K\u001b[1A\u001b[K\u001b[1A\u001b[K\u001b[1A\u001b[K\u001b[1A\u001b[K\u001b[1A\u001b[K\u001b[1A\u001b[K\u001b[1A\u001b[K \u001b[32m\u2713\u001b[39m test/stress.test.ts \u001b[2m(\u001b[22m\u001b[2m1 test\u001b[22m\u001b[2m)\u001b[22m\u001b[33m 1134\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m\u2713\u001b[39m stress trace (1.27M events) \u001b[2m(1)\u001b[22m\r\n     \u001b[33m\u001b[2m\u2713\u001b[22m\u001b[39m matches traceprinter event counts per type and parses quickly \u001b[33m 1133\u001b[2mms\u001b[22m\u001b[39m\r\n \u001b[32m\u2713\u001b[39m test/conformance.test.ts \u001b[2m(\u001b[22m\u001b[2m6 tests\u001b[22m\u001b[2m)\u001b[22m\u001b[33m 1150\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m\u2713\u001b[39m binary .kev reader matches the SDP traceprinter \u001b[2m(6)\u001b[22m\r\n     \u001b[32m\u2713\u001b[39m inversion: same events, same decoded fields\u001b[32m 257\u001b[2mms\u001b[22m\u001b[39m\r\n     \u001b[32m\u2713\u001b[39m inversion-fixed: same events, same decoded fields\u001b[32m 170\u001b[2mms\u001b[22m\u001b[39m\r\n     \u001b[32m\u2713\u001b[39m ist-latency: same events, same decoded fields\u001b[32m 143\u001b[2mms\u001b[22m\u001b[39m\r\n     \u001b[32m\u2713\u001b[39m send-chain: same events, same decoded fields\u001b[32m 131\u001b[2mms\u001b[22m\u001b[39m\r\n     \u001b[32m\u2713\u001b[39m cpu-hog: same events, same decoded fields\u001b[32m 147\u001b[2mms\u001b[22m\u001b[39m\r\n     \u001b[32m\u2713\u001b[39m baseline: same events, same decoded fields\u001b[32m 300\u001b[2mms\u001b[22m\u001b[39m\r\n\r\n\u001b[2m Test Files \u001b[22m \u001b[1m\u001b[32m2 passed\u001b[39m\u001b[22m\u001b[90m (2)\u001b[39m\r\n\u001b[2m      Tests \u001b[22m \u001b[1m\u001b[32m7 passed\u001b[39m\u001b[22m\u001b[90m (7)\u001b[39m\r\n"]
