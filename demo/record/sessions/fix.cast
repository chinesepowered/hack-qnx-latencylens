[0.0, "o", "\u001b[1;32m$\u001b[0m "]
[1.15, "o", "sed -i 's/PTHREAD_PRIO_NONE$/PTHREAD_PRIO_INHERIT/' brakesim.c"]
[1.1502, "o", "\r\n"]
[1.1539, "o", "\u001b[1;32m$\u001b[0m "]
[2.6039, "o", "diff -u brakesim.c.orig brakesim.c"]
[2.6057, "o", "\r\n"]
[2.6082, "o", "--- brakesim.c.orig\t2026-11-23 20:18:43.774628931 +0000\r\n+++ brakesim.c\t2026-11-23 20:18:48.153433865 +0000\r\n@@ -36,7 +36,7 @@\r\n  * the default. QNX's own default is PTHREAD_PRIO_INHERIT: the owner of the lock runs at the priority\r\n  * of the highest-priority thread waiting for it. Change this line to fix the sample. */\r\n #ifndef LOG_LOCK_PROTOCOL\r\n-#define LOG_LOCK_PROTOCOL PTHREAD_PRIO_NONE\r\n+#define LOG_LOCK_PROTOCOL PTHREAD_PRIO_INHERIT\r\n #endif\r\n \r\n #define BRAKE_PERIOD LL_MS(20)\r\n"]
[2.6085, "o", "\u001b[1;32m$\u001b[0m "]
[5.9585, "o", "qcc -Vgcc_ntox86_64 -O2 -o brakesim brakesim.c && qnx-vm put brakesim /tmp/brakesim"]
[5.9589, "o", "\r\n"]
[6.7589, "o", "\u001b[1;32m$\u001b[0m "]
[8.3089, "o", "qnx-vm ssh 'tracelogger -w -s 5 -f /dev/shmem/fixed.kev & sleep 1; /tmp/brakesim -s 3; wait'"]
[8.309, "o", "\r\n"]
[9.109, "o", "brakesim: protocol=PTHREAD_PRIO_INHERIT\r\nbrake_ctl: 150 jobs, 0 deadline misses (deadline 15.0 ms), worst response 4.56 ms\r\n"]
[9.8382, "o", "\u001b[1;32m$\u001b[0m "]
[12.1882, "o", "qnx-vm get /dev/shmem/fixed.kev ."]
[12.1887, "o", "\r\n"]
[12.9887, "o", "\u001b[1;32m$\u001b[0m "]
[14.5387, "o", "latencylens report fixed.kev --deadlines brakesim.deadlines.yaml --format summary; echo \"exit status $?\""]
[14.539, "o", "\r\n"]
[14.7029, "o", "fixed.kev: no findings (QNX 8.0.0, 2 CPUs, 5.00 s, 20,916 events)\r\n"]
[14.7095, "o", "exit status 0\r\n\u001b[1;32m$\u001b[0m "]
